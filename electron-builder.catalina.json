{
  "appId": "com.testcat.desktop",
  "productName": "Test cat",
  "electronVersion": "28.3.3",
  "asar": true,
  "artifactName": "${productName}-${version}-catalina-${arch}.${ext}",
  "directories": {
    "output": "release"
  },
  "files": [
    "src/**/*",
    "assets/**/*",
    "resources/**/*",
    "!resources/ios-performance-runtime/**/*",
    "!resources/platform-tools/**/*",
    "CHANGELOG.md",
    "package.json"
  ],
  "asarUnpack": [
    "src/ios-performance-helper.py"
  ],
  "extraResources": [
    {
      "from": "resources/ios-performance-runtime",
      "to": "ios-performance-runtime",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "resources/platform-tools",
      "to": "platform-tools",
      "filter": [
        "**/*"
      ]
    }
  ],
  "mac": {
    "icon": "assets/icons/test-cat.icns",
    "category": "public.app-category.developer-tools",
    "minimumSystemVersion": "10.15.0",
    "target": [
      "dmg",
      "zip"
    ]
  }
}
