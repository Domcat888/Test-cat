{
  "appId": "com.testcat.desktop",
  "productName": "Test cat",
  "electronVersion": "28.3.3",
  "asar": true,
  "artifactName": "${productName}-${version}-catalina-${arch}.${ext}",
  "directories": {
    "output": "release"
  },
  "files": [
    "src/**/*",
    "assets/**/*",
    "resources/**/*",
    "!resources/ios-performance-runtime/**/*",
    "!resources/platform-tools/**/*",
    "package.json"
  ],
  "asarUnpack": [
    "src/ios-performance-helper.py",
    "src/ios-mirror-helper.py",
    "src/ios-valeria-helper.py",
    "resources/ios-valeria/**/*"
  ],
  "extraResources": [
    {
      "from": "resources/ios-performance-runtime/darwin-x64",
      "to": "ios-performance-runtime/darwin-x64",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "resources/platform-tools/darwin-x64",
      "to": "platform-tools/darwin-x64",
      "filter": [
        "**/*"
      ]
    }
  ],
  "mac": {
    "icon": "assets/icons/test-cat.icns",
    "category": "public.app-category.developer-tools",
    "minimumSystemVersion": "10.15.0",
    "extendInfo": {
      "NSScreenCaptureUsageDescription": "Test cat 需要读取屏幕画面，用于截图、区域录屏和测试取证。",
      "NSMicrophoneUsageDescription": "Test cat 仅在录屏时按你的选择采集麦克风声音。"
    },
    "target": [
      "dmg",
      "zip"
    ]
  }
}
